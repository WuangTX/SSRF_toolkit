flowchart LR
  %% Người dùng & UI
  U[Người dùng] -->|Tương tác| UI["Web UI<br/>(web_ui/app.py)"]

  %% Core
  UI --> Core["Core Orchestrator<br/>(core/*)"]
  Core --> Config["Config<br/>(core/config.py)"]
  Core --> Logger["Logger<br/>(core/logger.py)"]
  Core --> DB[("Cơ sở dữ liệu<br/>(core/database.py)")]

  %% Modules
  subgraph Modules["Modules (Kiểm thử)"]
    direction LR
    BB["Blackbox<br/>(blackbox/)"]
    GB["Graybox<br/>(graybox/)"]
    WB["Whitebox<br/>(whitebox/)"]
  end

  Core --> Modules
  Modules -->|Lưu kết quả| DB

  %% Blackbox internals
  subgraph Blackbox["Blackbox (chi tiết)"]
    direction TB
    Recon["Thu thập thông tin<br/>(reconnaissance/)"]
    Detect["Phát hiện<br/>(detection/)"]
    Exploit["Khai thác<br/>(exploitation/)"]
  end
  BB --> Recon --> Detect --> Exploit
  Exploit --> DB

  %% Graybox & Whitebox
  GB --> Arch["Phân tích kiến trúc<br/>(architecture/)"]
  GB --> Auth[Phân tích xác thực]
  WB --> Static["Phân tích tĩnh<br/>(static_analysis/)"]
  WB --> Dynamic[Phân tích động]

  %% Tools & Utils
  Tools["Tools & Utils<br/>(tools/, utils/, wordlists/)"]
  Modules --> Tools
  Core --> Tools

  %% Targets & Reports
  Targets[Hệ thống mục tiêu<br/>(Microservices)] -->|Kiểm thử| Modules
  DB --> Reports["Báo cáo (reports/)"]
  UI --> Reports

  %% Notes / styling
  classDef core fill:#E8F0FF,stroke:#2B6B0;
  classDef modules fill:#E6FFFA,stroke:#2F855A;
  classDef tools fill:#FFF7ED,stroke:#DD6B20;
  classDef db fill:#FFF1F2,stroke:#C026D3;
  class Core,DB core;
  class Modules modules;
  class Tools tools;
  class DB db;
